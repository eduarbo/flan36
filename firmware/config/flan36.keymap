#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
/ { keymap { compatible = "zmk,keymap";
 base { bindings = <
  &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
  &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI
  &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH
  &mt LCTRL ESC &mo 1 &mt LSHFT SPACE &mt RSHFT ENTER &mo 2 &mt LGUI BSPC
 >; };
 numbers { bindings = <
  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
  &kp ESC &kp TAB &kp HOME &kp UP &kp END &kp LEFT &kp DOWN &kp RIGHT &kp PG_UP &kp PG_DN
  &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
  &trans &trans &trans &trans &trans &trans
 >; };
 symbols { bindings = <
  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR
  &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp EQUAL &kp MINUS &kp UNDER &kp PLUS &kp BSLH &kp PIPE
  &kp GRAVE &kp TILDE &kp DQT &kp SQT &kp LALT &kp DEL &kp F11 &kp F12 &kp C_VOL_DN &kp C_VOL_UP
  &trans &mo 3 &trans &trans &trans &trans
 >; };
 settings { bindings = <
  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &out OUT_BLE &out OUT_USB &bootloader &sys_reset
  &none &none &none &none &none &none &none &none &none &none
  &none &none &none &none &none &none &none &none &none &none
  &trans &trans &trans &trans &trans &trans
 >; };
}; };
&mt { flavor = "hold-preferred"; tapping-term-ms = <200>; quick-tap-ms = <175>; };
